<!-- The DbContext, saga rows, history, correlation map (W2). Empty until then; no EF Core package yet. Depends on Contracts only. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fworker.Persistence</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- W2.0: the DbContext and its migrations (W2.1); Wolverine's EF Core saga storage and outbox (ADR 0001) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.56.0" />
    <!-- Microsoft.Data.SqlClient 6.1.7 (through EF Core SqlServer) brings Pkcs 9.0.11, which has advisories GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7: lifted to a patched version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fworker.Contracts/Fworker.Contracts.csproj" />
  </ItemGroup>
</Project>
