@startuml fwr-seams
skinparam dpi 150
skinparam componentStyle rectangle
title fworker refactor (revised 2026-10-26): one gateway process, one acting engine per environment, three seams

actor "AI session" as S
actor "GitHub / Octopus" as X
package "Gateway process (engine composed at start for FACTORY_ENVIRONMENT)" {
  [S1 Verb router\none engine interface:\nv1 rule scripts, or v2 sagas (InvokeAsync / event)] as S1
  [S3 Event ingress\nwebhooks, verbs' events,\nOctopus watcher, board reconciler;\nfeeds the shadow engine too] as S3
  [S2 Command port\none integration command per side effect\n(outbox); or the recording sink] as S2
  [Recording sink\nshadow mode and the golden-write\ncomparison with v1's writes] as REC
  package "v1 engine (acts until the cutover; removed after it)" {
    [Sweep + rule scripts in pwsh children (RunnerPool),\nPlant, leader lease, snapshot;\nreads the state comment (rollback path)] as V1
  }
  package "v2 engine (shadow from R2, acting from the cutover)" {
    [Wolverine, Balanced mode, leader election:\nsagas, coordinators, integration handlers,\nsession mailbox; state comment kept in v1's format] as V2
  }
  [Switch\nengine: v2Environments, shadowEnvironments\n(config/deploy.overrides.json);\nFACTORY_V2_OFF (kill switch: back to v1, no shadow);\nrollback also by revert] as SW
}
database "Azure SQL\n(where v2 runs)" as DB

S --> S1
X --> S3
S1 --> V1 : engine v1
S1 --> V2 : engine v2
S3 --> V1 : RequestSweep(item)
S3 --> V2 : publish (inbox, dedup)
V1 --> X : its own writes
V2 --> S2
S2 --> X : when acting
S2 --> REC : in shadow
SW ..> S1
SW ..> S3
SW ..> S2
V2 --> DB
S2 --> DB : outbox
@enduml
