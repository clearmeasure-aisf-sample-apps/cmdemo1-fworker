@startuml fwr-phases
skinparam dpi 150
title fworker refactor (revised 2026-10-26): phases and their tdd gates; tdd switches engines once, as a whole

start
partition "Stage C  Program.cs becomes a composition root" {
  :behaviour-neutral steps C-1, C0 .. C8;
}
:gate: architecture test; golden writes unchanged; 1 measured batch, no regression;\n/ready 200, leader acting, restore ok; 4-hour quiet tdd window;
partition "R0  Prerequisites and safety (v1)" {
  :aisf off board 679;
  :v1 fixes (fencing, day budget, rev check); quick wins;\nflow metrics in the state comment; engine switch per environment;
}
:gate: Tier 1 green; 2-hour tdd window, no stage slower;
partition "R1  Structure and seams S1 to S3, v1 only" {
  :projects (host name kept); first Domain ports + parity tests;
  :S1 verb router, S2 command contracts + recording sink, S3 ingress; verb inventory;
}
:gate: golden writes identical (CI);
partition "R2  Wolverine host, tdd in shadow mode" {
  :Azure SQL, one replica; Balanced mode, leader election, session mailbox;\nbackground storage setup; OpenTelemetry; dead-letter admin;
  :shadow mode: v2 reads events, commands to the recording sink;\nSQL Server in CI; Tier 1 job on v2 with the golden diff;
}
:gate: 2-hour window; v2 leading; history for every event;\nv1 acts with the database stopped;
partition "R3  Durable side effects (v2)" {
  :runtime start/stop, runbook runs, journal ledger in C#,\nCopilot reservation as integration commands; classified errors;
}
:gate: kill scenarios on v2; 2-hour shadow window matches v1's writes;
partition "R4  Durable ingress and board reconciler" {
  :webhooks and the Octopus watcher into the inbox; correlation map;\nboard reconciler (or projects_v2_item delivery);
}
:gate: 2-hour shadow window: every board change has its event;
partition "R5  DeliveryTrainSaga" {
  :ItemMerged from the merge webhook; shadow run against the board;
}
:gate: 4 hours or 3 app releases, zero unexplained differences;
partition "R6  Docs plan" {
  :WorkItemSaga, direct merge in C#; projections\n(state comment kept in v1's format for rollback);
}
:gate: docs suites green on v2 with golden writes (CI);
partition "R7  Feature plan" {
  :full scheduler, merge train, delivery-speed section 5;\nsmoke evidence; approved cross-repo pieces;
}
:gate: feature suites green on v2 with golden writes (CI);
partition "R9  The rest of v2, then the cutover" {
  :QC ported; every verb to its destination (inventory table);\ntranscripts to the database;
  :tdd switches to v2 as a whole; adoption of open items and Sign-offs;\nkill-switch drill (FACTORY_V2_OFF, v1 resumes, back to v2);
}
:cutover gate: 1 measured batch on v2, no regression;\n/ready 200, leader, sagas resumed; 4-hour quiet window;
fork
  partition "R8  Incidents" {
    :IncidentSaga, hotfix plan, alert webhooks, rollback via the train;
  }
  :gate: a staged incident in tdd, end to end;
fork again
  partition "R9  v1 removed" {
    :remove the sweep engine, server rule scripts, lease, snapshot, shadow mode;
  }
  :gate: 2-hour window; Tier 1 green with v1 gone;
end fork
stop
@enduml
