@startuml cwr-foundry-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Container view: Foundry runtime (split design)
System_Boundary(cae, "Container Apps environment") {
  Container(gw, "fworker gateway", "ASP.NET Core 10", "FoundryRuntime: invokes the agent; the agent talks back over the same stream and verbs")
  Container(job, "fwrunner Container Apps Job", "same image as CAE runtime", "build, unit/integration/acceptance tests, push")
}
System_Boundary(fd, "Microsoft Foundry project (South Central US or nearest supported region)") {
  Container(agent, "Hosted agent fw-designer", "fwrunner-based image: Claude Code CLI headless behind a thin Invocations wrapper", "Technical Design, review, Functional Testing verdict reasoning; no build")
  Container(models, "Model deployments", "Claude Opus/Sonnet/Haiku (Foundry)", "")
}
Container_Ext(kv, "Key Vault")
Container_Ext(ai, "Application Insights")
System_Ext(gh, "GitHub")
Rel(gw, agent, "invoke (Invocations protocol) with item, phase, one-time nonce", "Entra token")
Rel(agent, gw, "SSE stream + verbs (w2, then i1)", "HTTP(S)")
Rel(agent, models, "inference", "agent identity")
Rel(gw, job, "start execution for build/test phases")
Rel(job, gh, "push")
Rel(agent, gh, "clone; push docs-only items (if egress allows)")
Rel(agent, ai, "traces")
Rel(gw, kv, "secrets")
@enduml
