@startuml fwi-waves
skinparam dpi 150
title Implementing ADR 0001 (revised 2026-10-26): stage C, a tdd gate in hours, the waves, one cutover of tdd (fork = may run together)

start
:W-1 decisions and prerequisites\n(actions outside the repo; Program.cs frozen for outside PRs);
partition "Stage C  Program.cs becomes a composition root (behaviour-neutral)" {
  fork
    :C-1 defect: board reading ignores other repositories;
  fork again
    :C0 safety net: golden writes, route-and-auth table,\nin-process calls, start-up test, CI job for smoke and parity;
  end fork
  fork
    :C1 classes after app.Run to files;
  fork again
    :C2 dashboard and connect prompt as embedded resources;
  end fork
  :C3 configuration (options, InstanceConfig);
  fork
    :C4a RevocationService;
    :C4b OperatorReleaseLoader;
  fork again
    :C4c TranscriptService;
  end fork
  :C4d LeadershipService + SnapshotCoordinator;
  :C5a AddGateway*, IPlantHooks, InProcess via EndpointDataSource;
  fork
    :C5b prompt builders, RuntimeRegistry;
    :C5c CopilotCiRelease, owner verbs, CloudOwnerWatch;
  fork again
    :C5d ManagerCopilotService, McpSessionSweeper;
  end fork
  :C6 GatewayAuthMiddleware, AdmissionService,\nICallerContext, PublicBase;
  :C7a modules: health, status, metrics, dashboard,\nplugin, operator releases; endpoint filters;
  fork
    :C7b modules: runtime hosts, Copilot, transcripts,\nwebhook, demo, item and worker admin;
  fork again
    :C7c modules: wait, events/SSE, presence,\nmessaging, supervisor, test hooks;
  end fork
  :C7d VerbEndpoints + VerbPipeline;
  :C8 policies, statics to DI, architecture test;
}
:stabilisation gate: architecture test (C8) green; golden writes unchanged;\n1 measured tdd batch, no regression; /ready 200, leader acting, restore ok after each release;\n4-hour quiet tdd window (batch inside);
partition "W0  safety and quick wins on v1" {
  :W0.0 engine switch per environment, FACTORY_V2_OFF reader;
  fork
    :W0.1 fencing;
    fork
      :W0.2 day budget;
    fork again
      :W0.3 rev, state budget;
    fork again
      :W0.8 flow metrics;
    fork again
      :W0.6 replenish backpressure;
      fork
        :W0.4 Depends-on refs;
      fork again
        :W0.9 ranking, slot freed;
      end fork
    end fork
  fork again
    :W0.5 exit-21 text;
  end fork
}
:gate: 2-hour tdd window, flow times, no stage slower; golden re-recorded;
partition "W1  structure and seams S1 to S3, no behaviour change" {
  :W1.0 projects, seam stubs;
  fork
    :W1.1 ItemId, catalog;
    fork
      :W1.2 catalog wiring;
    fork again
      :W1.8 token repo claim;
    end fork
  fork again
    :W1.3 Domain first ports;
  fork again
    :W1.4 S1 engine per environment;
    :W1.6 S3 ingress (can feed a shadow engine);
  fork again
    :W1.5 S2 command contracts, recording sink;
  fork again
    :W1.9 isolation tests;
    note right: W1.9 after W0.4 and W1.0
  fork again
    :W1.10 verb inventory;
  end fork
}
:gate: golden writes identical to the W0-gate baseline (CI);
fork
  partition "W2..W8 (the plan's tables are the source for their tasks, parallel groups and gates)" {
    :W2 Wolverine host, Balanced, mailbox; tdd in shadow mode (2 h window);
    :W3 v2 integration commands (2 h shadow window);
    :W4 ingress, board reconciler (2 h shadow window);
    :W5 DeliveryTrainSaga (shadow run: 4 h or 3 app releases);
    :W6 docs plan (v2 Tier 1 job, CI);
    :W7 feature plan (v2 Tier 1 job, CI);
    :W9.0..W9.8 QC and the remaining verbs on v2;
    :W9.9 tdd cutover to v2 as a whole: adoption, kill-switch drill;
    :cutover gate: 1 measured batch on v2; 4-hour quiet window;
    fork
      :W8 incidents (staged incident);
    fork again
      :W9.11 remove v1 (2 h window);
    end fork
  }
fork again
  partition "Lane D beside W1..W7" {
    :D2, D3 (before W5);
    :D4, D5 (before W6);
    :D1, D6, D7 (before W7);
  }
end fork
stop
@enduml
