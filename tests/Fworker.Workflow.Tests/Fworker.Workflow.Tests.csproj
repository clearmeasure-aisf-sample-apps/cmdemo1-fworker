<!-- Tests of src/Fworker.Workflows (sagas, scheduler, reconcilers; Wolverine tracked sessions from W2 on). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fworker.Workflow.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- W2.0's package (the gateway's host uses it too): the harness runs Wolverine against SQL Server with the durable outbox -->
    <PackageReference Include="WolverineFx.SqlServer" Version="6.56.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- tdd's recorded Octopus history (RecordedOctopusHistoryTests): read only from Octopus, no secret in it -->
    <None Include="../fixtures/octopus-tdd-2026-10-28/octopus-history.json" Link="fixtures/octopus-tdd-2026-10-28/octopus-history.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the SQL the 8 EF migrations ran on tdd before DbUp took over (LegacyDatabaseUpgradeTests) -->
    <None Include="../fixtures/ef-migrations-2026-10-29/ef-migrations.sql" Link="fixtures/ef-migrations-2026-10-29/ef-migrations.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fworker.Workflows/Fworker.Workflows.csproj" />
    <ProjectReference Include="../../src/Fworker.Persistence/Fworker.Persistence.csproj" />
    <ProjectReference Include="../../src/Fworker.Database/Fworker.Database.csproj" />
    <ProjectReference Include="../../src/Fworker.Integrations/Fworker.Integrations.csproj" />
  </ItemGroup>
</Project>
