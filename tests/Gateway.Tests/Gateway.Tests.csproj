<!-- The gateway's in-process tests (docs/design/gateway-composition.md 6): the route-and-auth table, the routes InProcess (MCP) depends on,
     and the start and stop of the host. The gateway runs in this process on TestServer; its rule scripts are a stub (StubPwsh.cs, Linux and
     macOS only). Outside gateway/ on purpose: the Web SDK of Gateway.csproj compiles every *.cs below its directory. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gateway.Tests</AssemblyName>
    <RootNamespace>Gateway.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../gateway/Gateway.csproj" />
  </ItemGroup>
</Project>
