<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FactoryWorker.Gateway</AssemblyName>
    <RootNamespace>FactoryWorker.Gateway</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Copilot cloud agent's stdio MCP proxy, served at /fworker-mcp.mjs -->
    <EmbeddedResource Include="Mcp/fworker-mcp.mjs" LogicalName="fworker-mcp.mjs" />
  </ItemGroup>
</Project>
