<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FactoryWorker.Gateway</AssemblyName>
    <RootNamespace>FactoryWorker.Gateway</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.56.0" />
    <!-- W2.0: the Wolverine host and its telemetry (registered from W2.2; nothing uses them yet) -->
    <PackageReference Include="WolverineFx.SqlServer" Version="6.56.0" />
    <PackageReference Include="WolverineFx.Http" Version="6.56.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- the host references every project of src/ (docs/design/fworker-wolverine-refactor.md 3); none of them references the host -->
    <ProjectReference Include="../src/Fworker.Contracts/Fworker.Contracts.csproj" />
    <ProjectReference Include="../src/Fworker.Domain/Fworker.Domain.csproj" />
    <ProjectReference Include="../src/Fworker.Persistence/Fworker.Persistence.csproj" />
    <ProjectReference Include="../src/Fworker.Integrations/Fworker.Integrations.csproj" />
    <ProjectReference Include="../src/Fworker.Workflows/Fworker.Workflows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Copilot cloud agent's stdio MCP proxy, served at /fworker-mcp.mjs -->
    <EmbeddedResource Include="Mcp/fworker-mcp.mjs" LogicalName="fworker-mcp.mjs" />
    <!-- the dashboard page and its connect-prompt generator, put together by Templates/DashboardPage.cs, served at /dashboard -->
    <EmbeddedResource Include="Templates/dashboard.html" LogicalName="dashboard.html" />
    <EmbeddedResource Include="Templates/connect-prompt.js" LogicalName="connect-prompt.js" />
    <!-- the text of the Cursor and Copilot runtimes' prompts, put together by Templates/RuntimePrompts.cs -->
    <EmbeddedResource Include="Templates/runtime-prompts.txt" LogicalName="runtime-prompts.txt" />
  </ItemGroup>
</Project>
